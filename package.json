{
  "name": "ng-universal-demo",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/angular/universal-starter.git"
  },
  "contributors": [
    "AngularClass <hello@angularclass.com>",
    "PatrickJS <patrick@angularclass.com>",
    "Jeff Whelpley <jeff@gethuman.com>",
    "Jeff Cross <crossj@google.com>",
    "Mark Pieszak <mpieszak84@gmail.com>",
    "Jason Jean <jasonjean1993@gmail.com>",
    "Fabian Wiles <fabian.wiles@gmail.com>"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4300",
    "build": "ng build",
    "lint": "ng lint --type-check",
    "lint:fix": "ng lint --fix",
    "lint:styles": "stylelint './src/**/*.scss'",
    "lint:styles:win": "stylelint src/**/*.scss",
    "linting": "npm run lint && npm run lint:styles",
    "linting:win": "npm run lint && npm run lint:styles:win",
    "build:prod:client": "NODE_OPTIONS=--openssl-legacy-provider ng build --prod",
    "build:prod:server": "ng build --prod --app 1 --output-hashing=false",
    "build:prod": "npm run build:prod:client -- --env=prod && npm run build:prod:server -- --env=prod",
    "build:dev": "npm run build:prod:client -- --env=dev && npm run build:prod:server -- --env=dev",
    "build:qa": "npm run build:prod:client -- --env=qa && npm run build:prod:server -- --env=qa",
    "build:prerender": "npm run build:prod && npm run webpack:server && npm run generate:prerender",
    "build:ssr:prod": "npm run build:prod && npm run webpack:server",
    "build:ssr:dev": "npm run build:dev && npm run webpack:server",
    "build:ssr:qa": "npm run build:qa && npm run webpack:server",
    "generate:prerender": "cd dist && node prerender",
    "webpack:server": "webpack --config webpack.server.config.js --progress --colors",
    "serve:prerender": "cd dist/browser && http-server",
    "serve:ssr": "node dist/server",
    "vercel-build": "npm run build:ssr:prod",
    "build:vercel": "npm run build:ssr:prod",
    "sprites": "node_modules/.bin/svg-sprite --config sprite-config.json src/assets/svg/*.svg"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^5.0.0",
    "@angular/common": "^5.0.0",
    "@angular/compiler": "^5.0.0",
    "@angular/core": "^5.0.0",
    "@angular/forms": "^5.0.0",
    "@angular/http": "^5.0.0",
    "@angular/platform-browser": "^5.0.0",
    "@angular/platform-browser-dynamic": "^5.0.0",
    "@angular/platform-server": "^5.0.0",
    "@angular/router": "^5.0.0",
    "@nebular/auth": "2.0.0-rc.7",
    "@nebular/theme": "2.0.0-rc.7",
    "@ng-bootstrap/ng-bootstrap": "1.1.0",
    "@ng-select/ng-select": "1.6.1",
    "@ngrx/effects": "5.2.0",
    "@ngrx/store": "5.2.0",
    "@nguniversal/common": "^5.0.0-beta.8",
    "@nguniversal/express-engine": "^5.0.0-beta.8",
    "@nguniversal/module-map-ngfactory-loader": "^5.0.0-beta.8",
    "@swimlane/ngx-charts": "7.4.0",
    "@swimlane/ngx-datatable": "11.3.0",
    "@tinymce/tinymce-angular": "3.3.1",
    "bootstrap": "4.0.0",
    "core-js": "^2.4.1",
    "file-saver": "^1.3.8",
    "font-awesome": "^4.7.0",
    "localstorage-polyfill": "^1.0.1",
    "moment": "^2.22.2",
    "ng-sidebar": "^7.2.0",
    "ng2-tree": "^2.0.0-rc.11",
    "ngx-permissions": "4.1.0",
    "ngx-toastr": "8.4.0",
    "ngx-treeview": "2.0.7",
    "ngx-ui-loader": "^1.2.4",
    "ngx-webstorage": "^2.0.1",
    "sass": "^1.32.0",
    "rxjs": "5.5.2",
    "spinkit": "^1.2.5",
    "xlsx": "^0.13.2",
    "zone.js": "^0.8.14",
    "@angular/cli": "1.7.2",
    "@angular/compiler-cli": "^5.0.0",
    "typescript": "~2.4.2",
    "@ngrx/store-devtools": "^5.1.0",
    "@types/node": "^8.0.30",
    "ngrx-store-freeze": "^0.2.4",
    "ts-loader": "^2.3.7",
    "node-sass": "^4.14.1"
  },
  "devDependencies": {
    "@angular/language-service": "^5.0.0",
    "codelyzer": "^4.0.2",
    "cpy-cli": "^1.0.1",
    "express": "^4.15.2",
    "http-server": "^0.10.0",
    "reflect-metadata": "^0.1.10",
    "regexp-replace-loader": "^1.0.1",
    "stylelint": "9.3.0",
    "svg-sprite": "^1.4.0",
    "tslint": "^5.7.0"
  }
}
